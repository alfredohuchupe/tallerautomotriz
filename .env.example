# Copia este archivo como .env y completa los valores (NUNCA subas .env a GitHub)
SECRET_KEY=cambia-esta-clave
# Opcional: base PostgreSQL (Neon). Sin esta variable se usa SQLite.
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Opcional: activa el asistente con IA (Groq). Sin clave funciona en modo local.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
WHATSAPP_PAIS=51
